  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "discovery:e2": "tsx scripts/discovery/e2-instrument-scan.ts",
    "discovery:e2:rules": "tsx scripts/discovery/e2-rules-extraction.ts",
