# Copy to .env.local and fill in. .env.local is git-ignored.
# Phase A / E1-E4 run entirely on public Bitget endpoints: no keys required below.

# --- E5 (optional, never a prerequisite) ---
# Preferred: a Bitget Demo Trading key (zero real funds). Alternative: a live
# read-only key scoped to UTA Trade read-only + UTA Management read-only only.
# Never commit this. Never let it reach a client bundle.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_DEMO_TRADING=false

# --- LLM layer (packages/llm) ---
# Provider-agnostic. "gemini" is the default until Qwen credits arrive;
# switching providers is a one-line env change, no code change.
LLM_PROVIDER=gemini   # gemini | qwen | none

# gemini: aistudio.google.com/apikey - free tier, no card required
GEMINI_API_KEY=

# qwen: issued by the hackathon Telegram admin
QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
